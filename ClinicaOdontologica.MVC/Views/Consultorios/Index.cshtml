@model IEnumerable<ClinicaOdontologica.Modelos.Consultorios>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Numero_Sala)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Piso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Equipamiento_Principal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Citas)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Numero_Sala)
            </td>
            <td>
                @Html.DisplayFor(model => item.Piso)
            </td>
            <td>
                @Html.DisplayFor(model => item.Equipamiento_Principal)
            </td>
            <td>
                @Html.DisplayFor(model => item.Citas)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdConsultorio">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdConsultorio">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdConsultorio">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
